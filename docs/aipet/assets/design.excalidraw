      "isDeleted": false,
      "boundElements": [],
      "updated": 1792846929097,
      "created": 1792659414419,
      "link": null,
      "locked": false,
      "text": "Available Tools:\n- recall_specific(type, time, keyword) ->\nMemo[]\n- recall_impression(type, keyword) ->\nImpression[]\n- inspect_user_hand() -> Item\n- inspect_surroundings() -> SurroundingItem[]\n- inspect_world() -> WorldDescription\n- inspect_user_pace() -> UserPaceInfo\n- record_impression(type, priority, impression)\n- react(brief, action)\n- silence()",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "_MHHmjLLHkSBuhU2Ga2Ep",
      "originalText": "Available Tools:\n- recall_specific(type, time, keyword) -> Memo[]\n- recall_impression(type, keyword) -> Impression[]\n- inspect_user_hand() -> Item\n- inspect_surroundings() -> SurroundingItem[]\n- inspect_world() -> WorldDescription\n- inspect_user_pace() -> UserPaceInfo\n- record_impression(type, priority, impression)\n- react(brief, action)\n- silence()",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
