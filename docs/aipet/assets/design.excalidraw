      "updated": 1792844619678,
      "created": 1792653812843,
      "link": null,
      "locked": false,
      "text": "Available Tools:\n- recall_specific(type, time, keyword) ->\nMemo[]\n- recall_impression(type, keyword) ->\nImpression[]\n- inspect_user_hand() -> Item\n- inspect_surroundings() -> SurroundingItem[]\n- inspect_world() -> WorldDescription\n- record_impression(type, priority, impression)\n- react(brief, act)\n- silence()",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "P4P9VvCkzyb7eO2PynkNS",
      "originalText": "Available Tools:\n- recall_specific(type, time, keyword) -> Memo[]\n- recall_impression(type, keyword) -> Impression[]\n- inspect_user_hand() -> Item\n- inspect_surroundings() -> SurroundingItem[]\n- inspect_world() -> WorldDescription\n- record_impression(type, priority, impression)\n- react(brief, act)\n- silence()",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
