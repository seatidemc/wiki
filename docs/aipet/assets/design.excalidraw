    {
      "id": "nlYWNv4Ldrg--IOAPiY0b",
      "type": "text",
      "x": 6102.769550161996,
      "y": 1101.0485576270096,
      "width": 31.679977416992188,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
